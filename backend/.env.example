# ==============================================================================
# Environment Configuration Template for AI Document Intelligence Assistant
# Copy this file to .env and replace placeholder values with your real configuration.
# DO NOT commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project & Environment Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="AI Document Intelligence Assistant"
ENVIRONMENT="development"                # Options: development, staging, production
DEBUG=True
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL with pgvector)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/doc_intelligence"
DATABASE_ECHO_SQL=False                  # Set to True to log raw SQL queries in development

# ------------------------------------------------------------------------------
# 3. Security & JWT Authentication
# Generate a secure secret using: openssl rand -hex 32
# ------------------------------------------------------------------------------
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440         # 1440 minutes = 24 hours

# ------------------------------------------------------------------------------
# 4. Google Gemini AI & Embeddings
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key-here"
EMBEDDING_MODEL="models/text-embedding-004"
EMBEDDING_DIMENSION=768
GENERATIVE_MODEL="gemini-1.5-flash"

# ------------------------------------------------------------------------------
# 5. Document Ingestion & Chunking Parameters
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10                    # Maximum allowed upload file size in megabytes
ALLOWED_FILE_EXTENSIONS=["pdf","txt"]   # JSON list of allowed file extensions
CHUNK_SIZE_CHARS=1500                    # Target chunk size in characters (~300-400 tokens)
CHUNK_OVERLAP_CHARS=200                  # Overlap between consecutive chunks to maintain context

# ------------------------------------------------------------------------------
# 6. RAG Retrieval & Similarity Search
# ------------------------------------------------------------------------------
VECTOR_SEARCH_TOP_K=5                    # Number of most relevant chunks to retrieve for context
SIMILARITY_THRESHOLD=0.60                # Minimum cosine similarity score (0.0 to 1.0) required to include a chunk

# ------------------------------------------------------------------------------
# 7. CORS (Cross-Origin Resource Sharing)
# Allowed frontend origins (JSON-encoded array of URLs)
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
